# Copy to `.env` (gitignored) to arm the covenant-parser fallback.
#
# The fallback is consulted only for a clause the deterministic parser
# cannot compile, and only ever proposes that clause's structure -- every
# figure stays arithmetic. With no key set, the run is fully offline and
# byte-identical to the deterministic pipeline, and `model` in the
# submission stays null.
#
# Whichever key is present decides the provider; set
# COVENANT_AGENT_MODEL_PROVIDER to pin one (anthropic | groq | off).

# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# COVENANT_AGENT_MODEL_PROVIDER=auto
# COVENANT_AGENT_ANTHROPIC_MODEL=claude-opus-5
# COVENANT_AGENT_GROQ_MODEL=llama-3.3-70b-versatile

# Bounds so a hung provider cannot eat the submission window.
# COVENANT_AGENT_MODEL_TIMEOUT=120
# COVENANT_AGENT_MODEL_MAX_CALLS=24
